# Copy this file to .env and fill in your values.

# PostgreSQL / TimescaleDB
POSTGRES_DB=citibikes
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Used by the scraper to connect to the database.
# In Docker Compose the host is the service name 'timescaledb'; for local dev use 'localhost'.
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/citibikes

# pgAdmin web UI (http://localhost:5050)
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password
