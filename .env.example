# Copy this file to .env and fill in your values.

# PostgreSQL / TimescaleDB
POSTGRES_DB=citibike
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Used by the scraper to connect to the database
DATABASE_URL=postgresql://your_user:$your_password@localhost:5432/citibike

# pgAdmin web UI (http://localhost:5050)
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=your_pgadmin_password
